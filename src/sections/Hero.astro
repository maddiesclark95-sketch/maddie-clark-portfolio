---
// Figma: "Hero banner" node 12666:7326 (within Homepage node 12666:7325).
// Pill data lives in src/data/heroPills.ts (pixel positions from a 1440×900
// canvas); <HeroPills> maps them proportionally onto the full-bleed hero and
// drops them under gravity. Not yet tuned for tablet/mobile.
import PrimaryNav from '../components/Nav/PrimaryNav.astro';
import HeroPills from '../components/Pill/HeroPills';
import { heroPills } from '../data/heroPills';
import Avatar from '../components/Avatar.astro';
---

<section class="hero">
  <div class="hero-bg-glow" aria-hidden="true"></div>

  <div class="hero-stage">
    <div class="hero-pills">
      <HeroPills pills={heroPills} client:load />
    </div>
  </div>

  <PrimaryNav />

  <div class="hero-contents">
    <div class="hero-bio">
      <p class="hero-bio-text">Hello</p>
      <Avatar src="/Assets/avatar-maddie-figma.png" alt="Maddie Clark" size={40} />
      <p class="hero-bio-text">I'm Maddie</p>
    </div>
    <h1 class="hero-headline">
      Product &amp; Digital Designer with a focus on Branding &amp; Creative Direction.
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    /* fill the screen on large displays (e.g. 16" MacBook Pro, 1728×~1000) */
    min-height: max(900px, 100vh);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1500);
    overflow: clip;
    padding: 180px var(--space-800) var(--padding-component-vertical-xl);
    background: var(--color-peach-50); /* #FEF3F2 */
  }

  /*
    Full-bleed physics stage. Pill start positions are converted from the
    1440×900 Figma canvas to percentages in HeroPills, so the pile spreads
    across the whole hero at any screen size instead of a fixed 1440 band.
  */
  .hero-stage {
    position: absolute;
    inset: 0;
  }

  /*
    A CSS radial gradient anchored at top-centre (50% 0%) instead of the
    rotated/blurred ellipse asset — guarantees the glow sits dead-centre and
    scales with the viewport at any width, rather than depending on matching
    a pre-rendered raster's blur bleed to a fixed-width stage.
  */
  .hero-bg-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 95% 760px at 50% 0%,
      rgba(249, 110, 79, 0.85) 0%,
      rgba(249, 110, 79, 0.45) 22%,
      rgba(253, 226, 223, 0.3) 42%,
      rgba(254, 243, 242, 0.14) 62%,
      rgba(254, 243, 242, 0) 85%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-pills {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-contents {
    position: relative;
    z-index: 2;
    /* let drags reach the physics canvas beneath the headline */
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-200);
    width: 100%;
  }

  .hero-bio {
    display: flex;
    align-items: center;
    gap: var(--space-100);
  }

  .hero-bio-text {
    font-family: var(--font-body);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-line-height);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* 10% up on the h1 token; max-width scaled with it so line breaks match Figma */
  .hero-headline {
    max-width: calc(680px * 1.1);
    font-family: var(--font-heading);
    font-weight: var(--h1-weight);
    font-size: calc(var(--h1-size) * 1.1);
    line-height: calc(var(--h1-line-height) * 1.1);
    letter-spacing: var(--h1-letter-spacing);
    color: var(--color-maroon-700);
    text-align: center;
  }
</style>
