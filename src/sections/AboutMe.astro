---
// Figma: "Work" section node 12706:9329 (front, profile) and "Bio card (back)"
// node 12711:9622 (CTA side, from section 12711:9698). The card is laid out
// at its 1006 x 524.87 Figma size with absolute positions, then scaled down
// to fit narrower containers by the script at the bottom.
// Hover (or tap on touch / focus a CTA) flips it to the back.
import Pill from '../components/Pill/Pill.astro';

// PLACEHOLDER: no email/phone in the Figma file — swap in the real ones.
const EMAIL_HREF = 'mailto:hello@example.com';
const PHONE_HREF = 'tel:+61000000000';

const CARD_W = 1006;
const CARD_H = 524.87;
---

<section class="about-me" id="about">
  <div class="about-me-border">
    <div class="about-card-frame" style={`--card-w: ${CARD_W}; --card-h: ${CARD_H};`}>
      <div class="about-card-scaler">
        <div class="about-card" data-about-card>
          <div class="about-card-inner">
            {['front', 'back'].map((side) => (
              <div class={`about-face about-face--${side}`}>
                <img class="about-face-bg" src={`/Assets/about/card-${side}-bg.svg`} alt="" />
                <img class="about-face-grid" src={`/Assets/about/grid-${side}.svg`} alt="" />
                <img class="about-face-markers" src={`/Assets/about/markers-${side}.svg`} alt="" />

                {/* top utility row */}
                <img class="about-abs about-dot" style="left: 12.03px; top: 12.58px;" src="/Assets/about/dot.svg" alt="" />
                <p class="about-abs about-mono about-mono--num" style="left: 48.11px; top: 12.03px;">01</p>
                <p class="about-abs about-mono" style="left: 301.26px; top: 13.12px;">PROFILE</p>
                <img class="about-abs about-square" style="left: 364.13px; top: 14.76px;" src="/Assets/about/square.svg" alt="" />
                <p class="about-abs about-mono" style="left: 643.51px; top: 13.67px;">ABOUT</p>
                <img class="about-abs about-square" style="left: 949.69px; top: 14.76px;" src="/Assets/about/square.svg" alt="" />

                {/* bottom utility row */}
                <p class="about-abs about-mono about-mono--num about-mono--regular" style="left: 169.49px; top: 502.45px; width: 46.47px; text-align: center;">04 / 06</p>
                <p class="about-abs about-mono" style="left: 367.41px; top: 503px;">CURRENTLY IN</p>
                <p class="about-abs about-mono" style="left: 644.94px; top: 504.09px; width: 55.68px; text-align: center;">MELBOURNE</p>
                <p class="about-abs about-mono" style="left: 898.93px; top: 504.09px; width: 55.68px; text-align: right;">AUSTRALIA</p>

                {side === 'front' ? (
                  <Fragment>
                    <div class="about-photo">
                      <img src="/Assets/about/bio-photo.png" alt="Portrait of Maddie Clark" />
                    </div>

                    <p class="about-abs about-mono about-mono--stack" style="left: 48.11px; top: 445.59px;">
                      NAME: MADDIE<br />TITLE: PRODUCT DESIGNER<br />DOB: 28/11/1995
                    </p>
                    <p class="about-abs about-mono about-mono--stack" style="left: 222.52px; top: 445.59px;">
                      FAVE COCKTAIL: MARGARITA<br />SYSTEM OF CHOICE: FIGMA<br />AI NATIVE: ABSOLUTELY
                    </p>

                    <h2 class="about-abs about-name" style="left: 364px; top: 67px;">Maddie Clark</h2>

                    <div class="about-abs about-titles" style="left: 364.13px; top: 213.77px;">
                      <p>Product Design</p>
                      <img src="/Assets/about/title-dot.svg" alt="" />
                      <p>Art Direction</p>
                      <img src="/Assets/about/title-dot.svg" alt="" />
                      <p>UX/UI</p>
                    </div>

                    <p class="about-abs about-body" style="left: 367px; top: 321px;">
                      With 6+ years across branding, art direction and digital design, I now bring<br />
                      that creative background into the world of UX/UI. The result?<br />
                      Digital experiences that are savvy, intuitive and full of brand personality.<br />
                      Because great UX should do more than just ‘work’ well. It should feel like you too.<br />
                      <br />
                      By day, I’m designing at award-winning agency Frank Digital. By night, I’m usually deep into a true crime doco on the couch. Somewhere in between, I’m always up for talking branding, digital and big ideas, so get in touch. I love a yap.
                    </p>
                  </Fragment>
                ) : (
                  <Fragment>
                    <h2 class="about-abs about-cta-heading" style="left: 345px; top: 189px; width: 316px;">Get in touch</h2>
                    <div class="about-cta">
                      <Pill label="Email me" icon="carbon-email.svg" variant="peach-50" href={EMAIL_HREF} />
                      <Pill label="Buzz me" icon="carbon-phone.svg" variant="peach-200" href={PHONE_HREF} />
                    </div>
                  </Fragment>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-me {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 92px 80px;
    background: var(--color-peach-50);
  }

  .about-me-border {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 40px;
  }

  /* No mobile spec in Figma yet — just trim the gutters so the scaled card stays legible. */
  @media (max-width: 767px) {
    .about-me {
      padding: var(--space-800) var(--space-200);
    }

    .about-me-border {
      padding: 0;
    }
  }

  /* Holds the card's Figma aspect ratio; the scaler inside is shrunk to fit. */
  .about-card-frame {
    --s: 1;
    width: 100%;
    max-width: calc(var(--card-w) * 1px);
    aspect-ratio: var(--card-w) / var(--card-h);
  }

  .about-card-scaler {
    width: calc(var(--card-w) * 1px);
    height: calc(var(--card-h) * 1px);
    transform: scale(var(--s));
    transform-origin: top left;
  }

  /*
    Motion: the card lifts slightly, then the face turns on a long, weighted
    curve that eases out with a touch of overshoot — slow to start, settles
    with intent. Using transitions (not keyframes) means leaving mid-flip
    reverses smoothly from wherever it is.
  */
  .about-card {
    --flip-duration: 1.1s;
    --flip-ease: cubic-bezier(0.65, 0, 0.2, 1.12);
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 2400px;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform var(--flip-duration) var(--flip-ease);
  }

  .about-face {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    overflow: clip;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 4px 12.4px rgba(251, 168, 157, 0.3);
    transition: box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-face--back {
    transform: rotateY(180deg);
    pointer-events: none;
  }

  .about-card.is-flipped,
  .about-card:focus-within {
    transform: translateY(-6px);
  }

  .about-card.is-flipped .about-card-inner,
  .about-card:focus-within .about-card-inner {
    transform: rotateY(180deg);
  }

  .about-card.is-flipped .about-face,
  .about-card:focus-within .about-face {
    box-shadow: 0 18px 40px rgba(251, 168, 157, 0.45);
  }

  .about-card.is-flipped .about-face--back,
  .about-card:focus-within .about-face--back {
    pointer-events: auto;
  }

  .about-card.is-flipped .about-face--front,
  .about-card:focus-within .about-face--front {
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .about-card:hover {
      transform: translateY(-6px);
    }

    .about-card:hover .about-card-inner {
      transform: rotateY(180deg);
    }

    .about-card:hover .about-face {
      box-shadow: 0 18px 40px rgba(251, 168, 157, 0.45);
    }

    .about-card:hover .about-face--back {
      pointer-events: auto;
    }

    .about-card:hover .about-face--front {
      pointer-events: none;
    }
  }

  /* Reduced motion: swap faces with a short crossfade instead of turning. */
  @media (prefers-reduced-motion: reduce) {
    .about-card,
    .about-card-inner,
    .about-card .about-card-inner {
      transform: none !important;
      transition: none;
    }

    .about-face {
      backface-visibility: visible;
      transition: opacity 0.3s ease;
    }

    .about-face--back {
      transform: none;
      opacity: 0;
    }

    .about-card.is-flipped .about-face--back,
    .about-card:focus-within .about-face--back,
    .about-card:hover .about-face--back {
      opacity: 1;
    }
  }

  .about-face-bg,
  .about-face-grid {
    position: absolute;
    left: 0;
    width: 100%;
    max-width: none;
  }

  .about-face-bg {
    top: 0;
    height: 100%;
  }

  .about-face-grid {
    top: -0.1%;
    height: 100.2%;
  }

  .about-face-markers {
    position: absolute;
    left: 12.03px;
    top: 141.06px;
    width: 323.67px;
    height: 372.33px;
    max-width: none;
  }

  .about-abs {
    position: absolute;
    margin: 0;
  }

  .about-dot {
    width: 10.935px;
    height: 10.935px;
  }

  .about-square {
    width: 6.561px;
    height: 6.561px;
  }

  .about-mono {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 8.201px;
    line-height: normal;
    letter-spacing: 0;
    color: var(--surface-invert-secondary);
    white-space: nowrap;
  }

  .about-mono--num {
    font-size: 9.841px;
  }

  .about-mono--regular {
    font-weight: 400;
  }

  .about-photo {
    position: absolute;
    left: 48px;
    top: 48px;
    width: 288px;
    height: 257px;
    overflow: clip;
    background: var(--color-brand-cream);
    border: 0.547px solid var(--color-peach-900);
  }

  /* Figma stretches this export into an 826:464 box — positions copied as-is. */
  .about-photo img {
    position: absolute;
    left: -98.55px;
    top: -66.96px;
    width: 637.66px;
    height: 358.2px;
    max-width: none;
    object-position: bottom;
  }

  .about-name {
    font-family: var(--font-heading);
    font-weight: var(--h1-weight);
    font-size: var(--h1-display-size);
    line-height: var(--h1-display-line-height);
    letter-spacing: var(--h1-display-letter-spacing);
    color: var(--color-maroon-700);
    white-space: nowrap;
  }

  .about-titles {
    display: flex;
    align-items: center;
    gap: 16.316px;
  }

  .about-titles p {
    font-family: var(--font-heading);
    font-weight: var(--h1-weight);
    font-size: 31.507px;
    line-height: 33.758px;
    letter-spacing: -0.5626px;
    color: var(--color-maroon-700);
    white-space: nowrap;
  }

  .about-titles img {
    width: 6.752px;
    height: 6.752px;
    flex-shrink: 0;
  }

  .about-body {
    width: 581px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 10.935px;
    line-height: 15.309px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-maroon-700);
  }

  .about-cta-heading {
    font-family: var(--font-heading);
    font-weight: var(--h1-weight);
    font-size: var(--h1-size);
    line-height: var(--h1-line-height);
    letter-spacing: var(--h1-letter-spacing);
    color: var(--color-maroon-700);
    text-align: center;
    white-space: nowrap;
  }

  .about-cta {
    position: absolute;
    left: calc(50% - 0.49px);
    top: 267px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-100);
  }
</style>

<script>
  const CARD_W = 1006;

  document.querySelectorAll<HTMLElement>('.about-card-frame').forEach((frame) => {
    new ResizeObserver(([entry]) => {
      frame.style.setProperty('--s', String(Math.min(1, entry.contentRect.width / CARD_W)));
    }).observe(frame);
  });

  // Touch devices have no hover: tap the card to flip it. Taps on the CTA
  // links fall through to the link as normal.
  const coarse = window.matchMedia('(hover: none), (pointer: coarse)');
  document.querySelectorAll<HTMLElement>('[data-about-card]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if (!coarse.matches || (e.target as HTMLElement).closest('a')) return;
      card.classList.toggle('is-flipped');
    });
  });
</script>
