---
// Bottom-of-viewport contact bar. Figma: "Sticky contact bar" node 12668:9894.
// Fixed to the viewport so it stays in view while the page scrolls.
import Avatar from './Avatar.astro';
---

<nav class="sticky-contact-bar" aria-label="Quick links">
  <div class="sticky-contact-bar-inner">
    <a href="/contact" class="sticky-contact-pill">
      <Avatar src="/Assets/avatar-maddie-figma.png" alt="" size={44} />
      <span class="sticky-contact-label">Contact</span>
    </a>
    <a href="/work" class="sticky-work-button" aria-label="Work">
      <img src="/Assets/icons/bytesize-portfolio.svg" alt="" />
    </a>
  </div>
</nav>

<style>
  .sticky-contact-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: var(--space-400) var(--space-800);
    /* only the pills are clickable — the full-width strip lets drags and
       clicks through to the page (e.g. the hero's physics pills) */
    pointer-events: none;
  }

  .sticky-contact-bar-inner {
    display: flex;
    align-items: center;
    gap: var(--space-100);
  }

  .sticky-contact-pill,
  .sticky-work-button {
    pointer-events: auto;
  }

  .sticky-contact-pill {
    display: flex;
    align-items: center;
    gap: var(--space-150);
    padding: var(--space-50) var(--space-300) var(--space-50) var(--space-50);
    background: var(--surface-primary);
    border: 1px solid rgba(255, 220, 205, 0.5);
    border-radius: var(--radius-rounded);
    box-shadow: -2px 3px 14.65px rgba(255, 220, 205, 0.7);
    text-decoration: none;
  }

  .sticky-contact-label {
    padding: var(--space-100) 0;
    font-family: var(--font-body);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-line-height);
    letter-spacing: var(--body-sm-letter-spacing);
    color: var(--text-primary);
    white-space: nowrap;
  }

  .sticky-work-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-rounded);
    background: var(--color-brand-maroon);
    box-shadow: -2px 3px 14.65px rgba(249, 110, 79, 0.3);
  }

  .sticky-work-button img {
    width: 26px;
    height: 26px;
  }
</style>
