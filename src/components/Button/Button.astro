---
// PLACEHOLDER: no dedicated CTA "Button" node was present on the hero
// banner frame — this is built from the cta-colour tokens in the MD file
// as a best guess. Replace with the real spec once a Button/CTA component
// node is shared from Figma (states: default/hover/active/disabled).
interface Props {
  href?: string;
  variant?: 'primary' | 'primary-invert' | 'secondary-invert';
  disabled?: boolean;
}

const { href, variant = 'primary', disabled = false } = Astro.props;
const Tag = href && !disabled ? 'a' : 'button';
---

<Tag
  href={href}
  disabled={disabled}
  class={`button button--${variant}`}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-100);
    padding: var(--space-150) var(--space-300);
    border: none;
    border-radius: var(--radius-rounded);
    font-family: var(--font-body);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-line-height);
    cursor: pointer;
  }

  .button--primary {
    background: var(--color-maroon-700);
    color: var(--cta-primary-text, #202020);
  }

  .button--primary-invert {
    background: var(--cta-primary-invert-surface);
    color: var(--text-primary);
  }

  .button--secondary-invert {
    background: var(--cta-secondary-invert-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-secondary);
  }

  .button:disabled {
    color: var(--cta-primary-text-disabled);
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>
