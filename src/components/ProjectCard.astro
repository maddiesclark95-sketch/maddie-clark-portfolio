---
// Image tile in the Featured Projects / About gallery.
// Figma: "ATB 1/2/3", "Unleashed 1" nodes — currently empty fills in Figma,
// wired here to the matching exports already in /Assets.
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="project-card">
  <img src={src} alt={alt} />
</div>

<style>
  .project-card {
    flex: 1;
    min-width: 0;
    height: 516px;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 2.204px 5.51px 24.134px 0px rgba(43, 4, 0, 0.3);
  }

  .project-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
