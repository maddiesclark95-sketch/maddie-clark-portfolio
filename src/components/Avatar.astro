---
// Small circular profile photo. Figma: "Bio" node 12666:7348 (source image
// asset: "Image (Maddie Clark)", node 12692:8322 — already a pre-composited
// circular crop with correct headroom baked in, so it's rendered at 100%).
interface Props {
  src: string;
  alt?: string;
  size?: number;
}

const { src, alt = '', size = 40 } = Astro.props;
---

<div class="avatar" style={`--avatar-size: ${size}px;`}>
  <img src={src} alt={alt} />
</div>

<style>
  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: var(--radius-rounded);
    background: var(--color-peach-800);
    overflow: hidden;
    flex-shrink: 0;
  }

  /* Nudged down so the top of the head clears the circle edge; the gap
     above shows the container's peach-800, which matches the photo's own
     background, and the overflow at the bottom is clipped by the circle. */
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(4%) scale(1.05);
  }
</style>
