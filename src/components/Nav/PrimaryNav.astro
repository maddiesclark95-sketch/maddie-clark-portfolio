---
// Figma: "PrimaryNavigation" node 12666:7352.
import NavItem from './NavItem.astro';

const links = [
  { label: 'Home', href: '/', active: true },
  { label: 'About', href: '/about' },
  { label: 'Work', href: '/work' },
  { label: 'Get in touch', href: '/contact' },
];
---

<nav class="primary-nav">
  <div class="primary-nav-inner">
    <ul class="primary-nav-list">
      {links.map((link) => (
        <li>
          <NavItem href={link.href} active={link.active}>{link.label}</NavItem>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .primary-nav {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: var(--space-400) var(--space-800);
  }

  .primary-nav-inner {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .primary-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-300);
    list-style: none;
    margin: 0;
    padding: var(--space-50) var(--space-100) var(--space-50) var(--space-50);
    background: var(--surface-tertiary);
    border-radius: 10000px;
    box-shadow: 0px 7px 8.65px rgba(60, 11, 12, 0.06);
  }
</style>
